# Valores de PRODUCCIÓN de Ling Marco Tickets. Plantilla SIN secretos: se copia como `.env` en el servidor y se rellena allí.
# NO es el `.env.example` (ese es el de desarrollo). Guía y razones de cada valor: docs/plan/produccion.md.
# Tras rellenarlo: `php artisan preflight:check` (debe salir con 0 errores) y `php artisan config:cache`.

APP_NAME="Ling Marco Tickets"
APP_ENV=production
APP_DEBUG=false
# ⚠ Se genera UNA vez (`php artisan key:generate`) y NO se cambia nunca: con ella se cifran las claves del segundo factor y las sesiones.
# Cambiarla las invalida (todos los administradores con 2FA perderían la clave). Guardar una copia fuera del servidor.
APP_KEY=
APP_URL=https://CAMBIAR-por-el-dominio-real
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

# Registros: rotación diaria y sin nivel debug (un registro en debug guarda también datos de clientes).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR
# La sesión de MySQL en UTC (valor por defecto; no cambiar: ver defecto D-13).
# DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Detrás de un proxy/balanceador que termina el HTTPS: IP o rangos separados por comas. Vacío = ningún proxy. «*» solo si la
# aplicación no es alcanzable sin pasar por el proxy. Sin esto no hay HSTS y los enlaces salen con http://.
TRUSTED_PROXIES=

# La cola corre en la base de datos y NECESITA un trabajador permanente (sin él no salen correos ni avisos): ver docs/plan/produccion.md.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Correo REAL. Con MAIL_MAILER=log los correos solo se escribirían en el registro y nadie los recibiría.
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="CAMBIAR@lingmarco.es"
MAIL_FROM_NAME="${APP_NAME}"

# Copias de seguridad (las hace el planificador cada noche): días que se conservan todas y meses que se conserva una por mes.
BACKUPS_KEEP_DAYS=14
BACKUPS_KEEP_MONTHS=3

# Conservación de datos (retention:run NO está programado; ver docs/plan/conservacion-datos.md). Plazos provisionales.
RETENTION_TICKETS_YEARS=2
RETENTION_LOGS_YEARS=2
RETENTION_FAILED_JOBS_DAYS=90
RETENTION_DEACTIVATED_USERS_YEARS=2
