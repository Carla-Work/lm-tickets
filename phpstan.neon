# Configuración de Larastan (análisis estático). Se ejecuta con `composer analyse`.
# Cuándo tocarlo: al subir de nivel o al añadir carpetas con código propio.
# Nivel 5 de partida: lo bastante estricto para cazar errores reales sin ahogar el
# arranque del proyecto. Subir de nivel es una decisión a tomar con la usuaria, no de paso.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    # Sin esto Larastan NO lee el cuerpo de `casts()` de los modelos (solo su tipo de retorno declarado) y
    # ve todas las columnas como `string`, también las enumeraciones y las fechas. Con ella, `$ticket->status`
    # es un TicketStatus. (Descubierto al implementar las policies; antes se creyó, erróneamente, que el
    # culpable era un PHPDoc `@return array<string, string>`.)
    parseModelCastsMethod: true
    paths:
        - app
        - routes
        - database
        - tests
