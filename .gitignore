# .gitignore del proyecto. Se crea ANTES del primer `git add` para que nunca entren
# secretos ni basura del sistema. Base: la del esqueleto de Laravel + lo propio del proyecto.
# Si algo parece sobrar, no lo borres sin mirar: casi todo evita que se cuelen secretos.

# Sistema operativo
.DS_Store
Thumbs.db

# Secretos y configuración local: nunca al repositorio (.env.example sí va)
.env
.env.backup
.env.production
/auth.json

*.log
.DS_Store
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Adjuntos de tickets (R3): datos de clientes, jamás al repositorio
/storage/app/private/
